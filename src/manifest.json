{
    "manifest_version": 3,
    "name": "C2PA Content Credentials",
    "version": "0.2.1",
    "description": "Verify and display manifests for images, audio and videos embedding C2PA Content Credentials.",
    "icons": {
        "16": "assets/icons/icon-16.png",
        "48": "assets/icons/icon-48.png",
        "128": "assets/icons/icon-128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "node_modules/@webcomponents/webcomponentsjs/webcomponents-bundle.js",
                "node_modules/onnxruntime-web/dist/ort.webgpu.min.js",
                "lib/trustmark/js/deps/bch_ecc.js",
                "lib/trustmark/js/tm_datalayer.js",
                "lib/trustmark/js/tm_watermark.js",
                "content/contentScript.js"
            ],
            "css": [
                "content/contentStyles.css"
            ]
        }
    ],
    "background": {
        "service_worker": "background/background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "assets/icons/icon-16.png",
            "48": "assets/icons/icon-48.png",
            "128": "assets/icons/icon-128.png"
        }
    },
    "permissions": [
        "offscreen",
        "tabs",
        "storage",
        "contextMenus"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
      },
    "web_accessible_resources": [
        {
            "resources": [                
                "assets/icons/*",
                "content/*",
                "content/fonts/*",
                "background/*",
                "lib/*",
                "lib/trustmark/js/*",
                "lib/trustmark/deps/*",
                "lib/trustmark/models/*",
                "node_modules/onnxruntime-web/dist/*",
                "popup/*",
                "offscreen/*",
                "config.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}